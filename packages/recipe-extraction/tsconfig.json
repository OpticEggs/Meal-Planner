{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": { "@/*": ["../../src/*"] }
  },
  "include": ["src/**/*.ts", "bin/**/*.ts", "bench/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
