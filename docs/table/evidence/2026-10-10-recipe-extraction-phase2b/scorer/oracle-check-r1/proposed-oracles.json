{
  "schema": "outcome-oracles/v1",
  "note": "R1 proposals (same format as bench/__tests__/oracles-v3.json). Expected values hand-derived from the plan text and confirmed with R1's independent checker; each kills one R1 self-mutation that the 71 oracles let survive.",
  "oracles": [
    { "id": "P01", "covers": ["C5a", "SCORE-01 alternatives arm", "bare no-amount negative"],
      "label": { "input": "Butter or oil, for greasing", "categories": ["ingredient_alternatives", "unstated_amount"], "expect": { "status": "needs_review", "alternatives": ["butter", "oil"], "amountUnstated": "other" } },
      "engine": { "output": { "status": "needs_review", "alternatives": ["butter", "oil"], "amountUnstated": "other", "reasons": ["ingredient_alternatives"] } },
      "expected": { "outcome": "C5", "partial": "a", "c1plus": false, "detailMismatch": false, "falseCertainty": null, "severe": [] },
      "calc": "ing-h2-0223 shape. Plan v3 §7(b) SCORE-01: bare = label quantity, unit AND alternatives all null; alternatives present → not bare (bareNoAmount false). Options matched on a choice label → a (reading 1)." },
    { "id": "P02", "covers": ["C5a", "SCORE-01 quantity arm", "bare no-amount negative"],
      "label": { "input": "1 m sausage", "categories": ["unit_unknown"], "expect": { "status": "needs_review", "name": "sausage", "quantity": "1" } },
      "engine": { "output": { "status": "needs_review", "name": "sausage", "quantity": "1", "reasons": ["unit_unknown"] } },
      "expected": { "outcome": "C5", "partial": "a", "c1plus": false, "detailMismatch": false, "falseCertainty": null, "severe": [] },
      "calc": "CONTRACT §12.14 shape (amount, unknown unit → needs_review). Label quantity 1, unit null → not bare (SCORE-01 needs quantity null too). Name matches, nothing contradicts → C5a." },
    { "id": "P03", "covers": ["CE nondeterministic", "unscored fields"],
      "label": { "input": "2 cups flour, sifted", "categories": ["integer_decimal", "prep_note"], "expect": { "status": "ready", "name": "flour", "quantity": "2", "unit": "cup", "note": "sifted" } },
      "engine": { "parses": [ { "output": { "status": "ready", "name": "flour", "quantity": "2", "unit": "cup", "note": "sifted" } },
                              { "output": { "status": "ready", "name": "flour", "quantity": "2", "unit": "cup", "note": "sifted", "evidence": { "spans": { "name": [7, 12] } } } } ] },
      "expected": { "outcome": "CE", "partial": null, "c1plus": false, "detailMismatch": false, "falseCertainty": null, "severe": [], "strict": { "outcome": "CE", "c1plus": false }, "ce": { "engineError": false, "invalid": false, "nondeterministic": true } },
      "calc": "Plan v3 §4: 'two parses of the line differ' — the whole output, not only scored fields (contract: same line → deep-equal output). Only evidence.spans differs → CE." },
    { "id": "P04", "covers": ["CE invalid output", "CE nondeterministic", "second parse"],
      "label": { "input": "2 cups flour, sifted", "categories": ["integer_decimal", "prep_note"], "expect": { "status": "ready", "name": "flour", "quantity": "2", "unit": "cup", "note": "sifted" } },
      "engine": { "parses": [ { "output": { "status": "ready", "name": "flour", "quantity": "2", "unit": "cup", "note": "sifted" } },
                              { "output": { "status": "ready", "name": "flour", "quantity": "2", "unit": "cup", "note": "sifted", "confidence": 0.9 } } ] },
      "expected": { "outcome": "CE", "partial": null, "c1plus": false, "detailMismatch": false, "falseCertainty": null, "severe": [], "strict": { "outcome": "CE", "c1plus": false }, "ce": { "engineError": false, "invalid": true, "nondeterministic": true } },
      "calc": "Plan v3 §4: 'an output that fails the complete contract validator' — the second output has a key outside the contract → invalid (as well as nondeterministic). The invalid flag must not depend on which parse is scored." },
    { "id": "P05", "covers": ["C1", "C1+", "exact rational equality"],
      "label": { "input": "1/2 cup sugar", "categories": ["fraction"], "expect": { "status": "ready", "name": "sugar", "quantity": "1/2", "unit": "cup" } },
      "engine": { "output": { "status": "ready", "name": "sugar", "quantity": { "kind": "exact", "numerator": "1", "denominator": "2", "display": "½" }, "unit": "cup" } },
      "expected": { "outcome": "C1", "partial": null, "c1plus": true, "detailMismatch": false, "falseCertainty": null, "severe": [] },
      "calc": "CONTRACT §9: quantity = exact rational equality; §2/contract.ts: display 'is a human rendering only and is never parsed back'. 1/2 = 1/2 → C1+ although the display is '½' (a scorer must not compare display text)." },
    { "id": "P06", "covers": ["C1", "C1+", "unit canonical code"],
      "label": { "input": "2 cups flour", "categories": ["integer_decimal"], "expect": { "status": "ready", "name": "flour", "quantity": "2", "unit": "cup" } },
      "engine": { "output": { "status": "ready", "name": "flour", "quantity": "2", "unit": { "canonical": "cup", "dimension": "volume", "source": "cups" } } },
      "expected": { "outcome": "C1", "partial": null, "c1plus": true, "detailMismatch": false, "falseCertainty": null, "severe": [] },
      "calc": "CONTRACT §9: unit = canonical code; unit.source ('cups', as written) is not compared → C1+." },
    { "id": "P07", "covers": ["C5b", "range upper end"],
      "label": { "input": "2-3 cloves garlic", "categories": ["range", "count_unit"], "expect": { "status": "needs_review", "name": "garlic", "quantity": "2..3", "unit": "clove" } },
      "engine": { "output": { "status": "needs_review", "name": "garlic", "quantity": "2..4", "unit": "clove", "reasons": ["quantity_range"] } },
      "expected": { "outcome": "C5", "partial": "b", "c1plus": false, "detailMismatch": false, "falseCertainty": null, "severe": [] },
      "calc": "CONTRACT §9: 'ranges: both ends' — 2..4 ≠ 2..3 (same lower end) → contradiction → C5b." },
    { "id": "P08", "covers": ["C3b", "S7 negative (needs_review output)"],
      "label": { "input": "1 cup 2% milk", "categories": ["percentage"], "expect": { "status": "ready", "name": "2% milk", "quantity": "1", "unit": "cup" } },
      "engine": { "output": { "status": "needs_review", "name": "milk", "quantity": "1", "unit": "cup" } },
      "expected": { "outcome": "C3", "partial": "b", "c1plus": false, "detailMismatch": false, "falseCertainty": null, "severe": [] },
      "calc": "v2 §5 S7: 'engine ready on a ready label' — engine needs_review → no S7; name 'milk' contradicts '2% milk' → C3b." },
    { "id": "P09", "covers": ["C2 high", "S2", "S4", "S7 negative (needs_review label)"],
      "label": { "input": "1-2 cups 2% milk", "categories": ["range", "percentage"], "expect": { "status": "needs_review", "name": "2% milk", "quantity": "1..2", "unit": "cup" } },
      "engine": { "output": { "status": "ready", "name": "milk", "quantity": "1", "unit": "cup" } },
      "expected": { "outcome": "C2", "partial": null, "c1plus": false, "detailMismatch": false, "falseCertainty": "high", "severe": ["S2", "S4"] },
      "calc": "Range collapsed on a ready output → S2; label needs_review → S4; S7 needs a ready LABEL → none although {milk} ⊊ {2%, milk}; C2 high." },
    { "id": "P10", "covers": ["C3c", "package only"],
      "label": { "input": "2 (15 oz) cans black beans", "categories": ["package_size", "count_unit"], "expect": { "status": "ready", "name": "black beans", "quantity": "2", "unit": "can", "packageSize": { "quantity": "15", "unit": "oz" } } },
      "engine": { "output": { "status": "needs_review", "packageSize": "15 oz" } },
      "expected": { "outcome": "C3", "partial": "c", "c1plus": false, "detailMismatch": false, "falseCertainty": null, "severe": [] },
      "calc": "Reading 1: c = 'name, quantity and unit are all null and no alternatives were read' — a matching package size alone does not lift it out of c (b is decided first and does not apply: 15 oz matches)." },
    { "id": "P11", "covers": ["CE invalid output", "unit dimension field"],
      "label": { "input": "8 oz cheddar", "categories": ["oz_vs_floz"], "expect": { "status": "ready", "name": "cheddar", "quantity": "8", "unit": "oz" } },
      "engine": { "output": { "status": "ready", "name": "cheddar", "quantity": "8", "unit": { "canonical": "oz", "dimension": "volume", "source": "oz" } } },
      "expected": { "outcome": "CE", "partial": null, "c1plus": false, "detailMismatch": false, "falseCertainty": null, "severe": [], "strict": { "outcome": "CE", "c1plus": false }, "ce": { "engineError": false, "invalid": true, "nondeterministic": false } },
      "calc": "The output's unit dimension contradicts UNIT_REGISTRY (oz is mass) → the complete validator fails → CE; never coerced to C1, and no S3 from the output's own dimension field." },
    { "id": "P12", "covers": ["CE invalid output", "unsupported input"],
      "label": { "input": "For the sauce:", "categories": ["heading_non_ingredient"], "expect": { "status": "unsupported" } },
      "engine": { "output": { "status": "unsupported", "name": "sauce", "reasons": ["section_heading"] } },
      "expected": { "outcome": "CE", "partial": null, "c1plus": false, "detailMismatch": false, "falseCertainty": null, "severe": [], "strict": { "outcome": "CE", "c1plus": false }, "ce": { "engineError": false, "invalid": true, "nondeterministic": false } },
      "calc": "CONTRACT §2.1: unsupported → name, quantity, unit, packageSize null; a name makes it invalid → CE, not C7 (C7 must not be decided by the status string alone)." },
    { "id": "P13", "covers": ["C3b", "S1"],
      "label": { "input": "salt to taste", "categories": ["unstated_amount", "seasoning_ordinary"], "expect": { "status": "ready", "name": "salt", "amountUnstated": "to_taste" } },
      "engine": { "output": { "status": "needs_review", "name": "salt", "quantity": "1", "unit": "pinch" } },
      "expected": { "outcome": "C3", "partial": "b", "c1plus": false, "detailMismatch": false, "falseCertainty": null, "severe": ["S1"] },
      "calc": "S1 at any status (label quantity null, engine 1) on a ready label read as needs_review; quantity contradicts → C3b." },
    { "id": "P14", "covers": ["C1", "detail mismatch", "amountUnstated"],
      "label": { "input": "salt to taste", "categories": ["unstated_amount", "seasoning_ordinary"], "expect": { "status": "ready", "name": "salt", "amountUnstated": "to_taste" } },
      "engine": { "output": { "status": "ready", "name": "salt", "amountUnstated": "as_needed" } },
      "expected": { "outcome": "C1", "partial": null, "c1plus": false, "detailMismatch": true, "falseCertainty": null, "severe": [] },
      "calc": "amountUnstated is not a core field (§3) → C1; it differs → not C1+, low detail mismatch." }
  ]
}
