# Copy to .env.local for local development. Never commit real values.
# TABLE_ENV: development | test | production. Test-only behavior (fixed clock,
# fixture seeding) is refused unless TABLE_ENV=test.
TABLE_ENV=development
DATABASE_URL=postgres://table@127.0.0.1:54329/table_dev
# Better Auth: generate with `openssl rand -base64 32`. Required in production.
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-bytes
BETTER_AUTH_URL=http://localhost:3000
# Retailer adapter: "simulated" (recording fake, always labeled) or "kroger".
# "kroger" fails closed: each capability needs its own activation AND complete configuration,
# and cart transfer stays not-ready until Kroger's `modality` is verified (see
# docs/table/INTEGRATION-CAPABILITIES.md). Server-side only; never commit real values.
TABLE_RETAILER=simulated
# Staged activation, comma list of connect, products, cart. Empty = none (the default).
# Production refuses any activation unless TABLE_RETAILER=kroger.
KROGER_ACTIVATE=
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Must equal a redirect URL registered for the Kroger app, ending in /api/kroger/callback.
KROGER_REDIRECT_URI=
KROGER_LOCATION_ID=
# Scope names assigned to YOUR registered app (no defaults; Kroger's pages disagree on names).
KROGER_CUSTOMER_SCOPES=
KROGER_PRODUCT_SCOPES=
KROGER_LOCATION_SCOPES=
# Seals Kroger tokens and PKCE verifiers at rest (AES-256-GCM). 32 random bytes, base64:
# openssl rand -base64 32. Without it nothing is stored and connect stays unavailable.
TABLE_TOKEN_KEY=
# USDA FoodData Central key (server-side only). Optional; unset means nutrition lookup is unavailable.
FDC_API_KEY=
