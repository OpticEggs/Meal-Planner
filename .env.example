# Copy to .env.local for local development. Never commit real values.
# TABLE_ENV: development | test | production. Test-only behavior (fixed clock,
# fixture seeding) is refused unless TABLE_ENV=test.
TABLE_ENV=development
DATABASE_URL=postgres://table@127.0.0.1:54329/table_dev
# Better Auth: generate with `openssl rand -base64 32`. Required in production.
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-bytes
BETTER_AUTH_URL=http://localhost:3000
# Retailer adapter: "simulated" (recording fake, always labeled) or "kroger".
# "kroger" fails closed until every KROGER_* value is present AND the live
# capability has been verified and authorized (see docs/table/INTEGRATION-CAPABILITIES.md).
TABLE_RETAILER=simulated
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_REDIRECT_URI=
KROGER_LOCATION_ID=
# USDA FoodData Central key (server-side only). Optional; unset means nutrition lookup is unavailable.
FDC_API_KEY=
