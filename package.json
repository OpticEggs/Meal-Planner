{
  "name": "table",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:start": "scripts/db.sh start",
    "db:stop": "scripts/db.sh stop",
    "db:migrate": "tsx scripts/migrate.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p .",
    "test:unit": "vitest run tests/unit",
    "test:integration": "DATABASE_URL=${TEST_DATABASE_URL:-postgres://table@127.0.0.1:54329/table_test} tsx scripts/migrate.ts && vitest run tests/integration",
    "test:e2e": "playwright test",
    "household:create": "tsx scripts/household-create.ts",
    "member:create": "tsx scripts/member-create.ts",
    "sample:recipes": "tsx scripts/sample-recipes.ts",
    "verify": "scripts/verify-all.sh"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "decimal.js": "10.6.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.0",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
