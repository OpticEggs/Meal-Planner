# Production environment for Table — PLACEHOLDERS ONLY. Real values live in the host's secret
# store (Render: service -> Environment), never in Git, chat, screenshots or exports.
TABLE_ENV=production
TABLE_RETAILER=simulated
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME          # from the managed database (internal URL)
BETTER_AUTH_SECRET=replace-me-with-32+-random-characters          # host-generated; rotating it signs everyone out
BETTER_AUTH_URL=https://your-service.onrender.com                 # exact https origin, no path, no trailing slash
# Optional, B7 (nutrition lookup). Empty = lookup shows "not configured".
FDC_API_KEY=
# Kroger (B5/B6) stays absent until a separate activation directive. With TABLE_RETAILER=simulated
# nothing is sent to a store even if these are present.
# KROGER_CLIENT_ID=
# KROGER_CLIENT_SECRET=
# KROGER_REDIRECT_URI=https://your-service.onrender.com/api/kroger/callback
# KROGER_LOCATION_ID=
# TABLE_TOKEN_KEY=                 # 32 random bytes, base64; encrypts stored Kroger tokens
# KROGER_ACTIVATE=                 # empty = nothing activated
# Never set in production (the health check refuses them): TABLE_FIXED_NOW, TABLE_DISPATCH_TIMEOUT_MS,
# TABLE_FDC_FIXTURES, TABLE_KROGER_FAKE_TRANSPORT.
